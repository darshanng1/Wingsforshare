rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (Firebase Auth UID)
    // Fields:
    //   - uid: string (required) - Firebase Auth UID
    //   - username: string (required) - Username for login
    //   - email: string (optional) - Email address
    //   - role: string (required, enum: ['admin', 'user']) - User role
    //   - createdAt: timestamp (optional) - Account creation timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "darshanng@gmail.com" && request.auth.token.email_verified == true));
    }

    function isClientOwner(data) {
      return isAuthenticated() && request.auth.uid == data.clientId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username', 'role']) &&
             data.uid is string &&
             data.username is string && data.username.size() > 0 && data.username.size() < 50 &&
             data.role in ['admin', 'client'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && 
                    (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && 
                    (isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if isAdmin() || isClientOwner(resource.data);
      allow write: if isAdmin();
    }

    match /performance/{perfId} {
      allow read: if isAdmin() || isClientOwner(resource.data);
      allow write: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isAdmin() || isClientOwner(resource.data);
      allow create: if isAuthenticated() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || isClientOwner(resource.data);
      allow write: if isAdmin();
    }
  }
}
